{
  "name": "@repo/kafka-mongo",
  "version": "1.0.1",
  "description": "Backend typescript express relay mongodb",
  "type": "module",
  "scripts": {
    "start": "node --watch --experimental-strip-types ./src/index.ts",
    "lint": "biome check",
    "serve": "KAFKA_ID=kafka-mongo node --experimental-strip-types ./src/index.ts",
    "pcm": "lint-staged",
    "test": "node --test --experimental-strip-types"
  },
  "author": "Armando Rueda",
  "license": "ISC",
  "dependencies": {
    "@repo/kafka-utils": "workspace:*",
    "@repo/logs-utils": "workspace:*",
    "@repo/mongo-utils": "workspace:*",
    "@repo/utils": "workspace:*",
    "date-fns": "^4.1.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-relay": "^0.10.2",
    "graphql-subscriptions": "^3.0.0",
    "ioredis": "^5.8.2",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@repo/typescript-config": "workspace:*",
    "@testcontainers/kafka": "^11.8.0",
    "@testcontainers/redis": "^11.8.0",
    "lint-staged": "^16.2.6",
    "testcontainers": "^11.8.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/!(*_pb).{js,ts}": [
      "biome check",
      "node --experimental-strip-types --test"
    ]
  }
}
