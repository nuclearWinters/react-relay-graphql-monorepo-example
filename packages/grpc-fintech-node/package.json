{
  "name": "@repo/grpc-fintech-node",
  "version": "1.0.1",
  "description": "Backend typescript express relay mongodb",
  "type": "module",
  "scripts": {
    "start": "node --watch --experimental-strip-types ./src/index.ts",
    "lint": "biome check",
    "serve": "KAFKA_ID=grpc-fintech-node node --experimental-strip-types ./src/index.ts",
    "pcm": "lint-staged",
    "test": "node --test --experimental-strip-types"
  },
  "author": "Armando Rueda",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@repo/grpc-utils": "workspace:*",
    "@repo/utils": "workspace:*",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@repo/typescript-config": "workspace:*",
    "@testcontainers/redis": "^11.8.0",
    "@types/node": "^24.10.0",
    "lint-staged": "^16.2.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/!(*_pb).{js,ts}": [
      "biome check",
      "node --experimental-strip-types --test"
    ]
  }
}
