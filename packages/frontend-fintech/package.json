{
  "name": "@repo/frontend-fintech",
  "version": "1.0.1",
  "description": " app built from zero",
  "main": "build/index.tsx",
  "scripts": {
    "start": "webpack serve --config webpack.config.js --env env=dev",
    "build": "webpack --config webpack.config.js --env env=prod && node copyPublicAssets.js",
    "analyze": "webpack --config webpack.config.js --env env=analyzer",
    "pcm": "lint-staged",
    "test": "node --require ./babel-register.js -r global-jsdom/register --test **/*.test.tsx",
    "relayAuth": "relay-compiler ./relayAuth.config.json",
    "relayFintech": "relay-compiler",
    "persist-server-auth": "node ./relayLocalPersistingAuth.js",
    "persist-server-fintech": "node ./relayLocalPersistingFintech.js",
    "lint": "biome check"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-relay": "^20.1.1",
    "relay-runtime": "^20.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.25.9",
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.39.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@stylexjs/webpack-plugin": "^0.11.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^19.0.3",
    "@types/relay-test-utils": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "babel-loader": "^10.0.0",
    "babel-plugin-relay": "^20.1.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-relay": "^2.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "fs-extra": "^11.2.0",
    "global-jsdom": "27.0.0",
    "graphql": "^16.9.0",
    "html-webpack-plugin": "^5.6.3",
    "lint-staged": "^16.2.6",
    "react-refresh": "^0.18.0",
    "relay-compiler": "^20.1.1",
    "relay-config": "^12.0.1",
    "relay-test-utils": "^20.1.1",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "webpack": "^5.96.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  },
  "author": "Armando Rueda",
  "license": "ISC",
  "lint-staged": {
    "**/!(*graphql).{js,jsx,ts,tsx}": [
      "biome check",
      "node --require ./babel-register.js -r global-jsdom/register --test **/*.test.tsx"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
